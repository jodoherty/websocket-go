{
  "name": "websocket-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright e2e tests for the websocket package, run against the Go demo server in Firefox and Chromium",
  "scripts": {
    "test": "playwright test",
    "test:go": "go -C .. test ./e2e -count=1",
    "test:all": "npm run test:go && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "ws": "^8.22.0"
  }
}
